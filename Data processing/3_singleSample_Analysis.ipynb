    "# Step 4: Score each cell state signature (filter to genes present in data)\n",
    "var_names = set(mdata['gex'].var_names)\n",
    "state_scores = []\n",
    "\n",
    "for state_name, genes in cd4_state_markers.items():\n",
    "    valid_genes = [g for g in genes if g in var_names]\n",
    "    if valid_genes:\n",
    "        score_name = f'{state_name}_score'\n",
    "        sc.tl.score_genes(mdata['gex'], gene_list=valid_genes, score_name=score_name)\n",
    "        state_scores.append(score_name)\n",
    "        print(f\"{state_name}: {len(valid_genes)}/{len(genes)} genes found\")\n",
    "    else:\n",
    "        print(f\"WARNING: {state_name}: No genes found in data\")"
